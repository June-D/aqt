# 应用
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./data/trade.db
CONFIG_PATH=configs/default.yaml

# 网关: sim | remote_xtquant
GATEWAY_TYPE=sim
GATEWAY_URL=http://127.0.0.1:8100
GATEWAY_TOKEN=change-me

# 实盘总开关（默认关闭）
LIVE_TRADING_ENABLED=false

# 模拟盘初始资金
INITIAL_CASH=1000000

# 单用户登录（留空 APP_PASSWORD 则本机免登录）
APP_USERNAME=aqt
APP_PASSWORD=

# OpenAI 兼容 LLM（情报交易）；也可在 UI「情报」相关设置中覆盖
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=180

# 千帆 AppBuilder AI 搜索（国内，按股票代码搜实时资讯）
# 控制台：https://console.bce.baidu.com/ai-search/
APPBUILDER_TOKEN=

# Tavily（可选新闻源）
TAVILY_API_KEY=

# ---- Windows XQA（agent/ 进程使用，可选）----
# QMT_ACCOUNT_ID=
# QMT_USERDATA_PATH=
# AGENT_HOST=0.0.0.0
# AGENT_PORT=8100
